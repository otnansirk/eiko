---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}

const {
  title = "Jasa Branding dan Web Development - Eiko Visual",
  description = "Eiko Visual adalah studio branding, web development, & digital marketing. Kami siap bantu kembangkan bisnis Anda. Konsultasi gratis!",
  ogImage = "/assets/branding/og-image.png",
  canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString(),
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes = "(max-width: 768px) 260px, 680px",
} = Astro.props;

const googleFontsUrl = "https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=Manrope:wght@500;600;700&family=Playfair+Display:ital,wght@1,600&family=Space+Grotesk:wght@400;500;600;700&display=swap";
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage}
        imagesrcset={preloadImageSrcset}
        imagesizes={preloadImageSrcset ? preloadImageSizes : undefined}
        fetchpriority="high"
      />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={googleFontsUrl} media="print" onload="const l=this;requestAnimationFrame(()=>requestAnimationFrame(()=>setTimeout(()=>{l.media='all'},50)))" />
    <noscript>
      <link rel="stylesheet" href={googleFontsUrl} />
    </noscript>

    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Eiko Visual - Your Branding Partner" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/assets/branding/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" href="/assets/branding/favicon-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/assets/branding/apple-touch-icon.png" />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Eiko Visual",
        "url": "https://www.eikovisual.com/",
        "logo": "/assets/branding/og-image.png",
        "image": "/assets/branding/og-image.png",
        "description": "Eiko Visual is your branding partner offering branding, 3D, apps, and web development built as one integrated system.",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "ID"
        },
        "sameAs": [
          "https://www.instagram.com/eikovisual",
          "https://www.linkedin.com/company/eikovisual",
          "https://www.facebook.com/eikovisuals/",
          "https://id.pinterest.com/EikoVisual_/",
          "https://www.behance.net/eikovisualid"
        ]
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content" class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .skip-link:focus {
    position: fixed;
    top: 12px;
    left: 12px;
    width: auto;
    height: auto;
    padding: 10px 16px;
    background: #FFFFFF;
    color: #030208;
    border-radius: 8px;
    z-index: 2000;
  }
</style>
