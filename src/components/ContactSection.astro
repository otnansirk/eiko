---
interface Props {
  badgeText?: string;
  heading?: string;
  description?: string;
}

const {
  badgeText = "Branding",
  heading = "Saatnya Brand Anda Tampil Konsisten di Setiap Titik Pertemuan dengan Pelanggan",
  description = "Ceritakan brand Anda, kami bantu rancang dari identitas sampai strategi pemasarannya.",
} = Astro.props;
---

<section class="contact-cta-section">
  <div class="container">
    <div class="contact-cta-box">
      <div class="contact-cta-left">
        <div class="contact-cta-badges">
          <div class="get-in-touch-badge">
            <img
              src="/assets/icons/sparkle-plus.webp"
              alt=""
              width="36"
              height="36"
              loading="lazy"
            />
            <span>Get in touch</span>
          </div>

          <div class="floating-badge">
            <span class="floating-badge-orange">{badgeText}</span>
            <img
              class="badge-cursor-icon"
              src="/assets/icons/cursor-contact.webp"
              alt=""
              width="34"
              height="34"
              loading="lazy"
            />
          </div>
        </div>

        <h2 class="gradient-para contact-cta-heading">{heading}</h2>
        {description && <p class="contact-cta-desc">{description}</p>}
      </div>

      <div class="contact-cta-right">
        <form class="eiko-contact-form" id="eiko-contact-form" data-mailto-form>
          <div class="form-row-2">
            <div class="form-field">
              <label for="mf-name">Name <span class="req">*</span></label>
              <input type="text" id="mf-name" name="name" placeholder="Alex Johnson" />
            </div>
            <div class="form-field">
              <label for="mf-phone">Phone <span class="req">*</span></label>
              <input type="tel" id="mf-phone" name="phone" placeholder="Phone Number" />
            </div>
          </div>

          <div class="form-field">
            <label for="mf-email">Email</label>
            <input type="email" id="mf-email" name="email" placeholder="Enter Your Email" />
          </div>

          <div class="form-field">
            <label for="mf-message">Messages</label>
            <textarea id="mf-message" name="message" rows="5" placeholder="Tell Us More About Projects..."></textarea>
          </div>

          <a href="mailto:project@eikovisual.com" class="eiko-btn" data-mailto-link>
            <span>Contact Us</span>
            <span class="btn-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3.33203 8H12.6654" stroke="#030208" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M8 3.33203L12.6667 7.9987L8 12.6654" stroke="#030208" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-mailto-form]').forEach((form) => {
    const link = form.querySelector('[data-mailto-link]');
    if (!link) return;
    const updateMailto = () => {
      const name = (form.querySelector('[name="name"]')?.value || '').trim();
      const phone = (form.querySelector('[name="phone"]')?.value || '').trim();
      const email = (form.querySelector('[name="email"]')?.value || '').trim();
      const message = (form.querySelector('[name="message"]')?.value || '').trim();
      if (!name && !phone && !email && !message) {
        link.setAttribute('href', 'mailto:project@eikovisual.com');
        return;
      }
      const subject = name ? `Inquiry from ${name} - Eiko Visual` : 'Project Inquiry - Eiko Visual';
      const bodyLines = [];
      if (name) bodyLines.push(`Name: ${name}`);
      if (phone) bodyLines.push(`Phone: ${phone}`);
      if (email) bodyLines.push(`Email: ${email}`);
      if (message) bodyLines.push(`\nMessage:\n${message}`);
      link.setAttribute(
        'href',
        `mailto:project@eikovisual.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join('\n'))}`
      );
    };
    form.addEventListener('input', updateMailto);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      updateMailto();
      window.location.href = link.getAttribute('href') || 'mailto:project@eikovisual.com';
    });
  });
</script>

<style>
  .contact-cta-section {
    padding: 80px 0 100px;
  }

  .contact-cta-box {
    background-color: #121117;
    border: 1px solid rgba(234, 234, 234, 0.14);
    border-radius: 40px;
    padding: 64px 56px;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 56px;
    align-items: start;
  }

  .contact-cta-badges {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .get-in-touch-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: "Inter Tight", sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #FFFFFF;
  }

  .contact-cta-heading {
    font-size: clamp(26px, 3.2vw, 40px);
    line-height: 1.3;
    margin-bottom: 20px;
  }

  .contact-cta-desc {
    color: #A7A7A7;
    font-size: 16px;
    line-height: 28px;
  }

  .eiko-contact-form {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-field label {
    font-family: "Inter Tight", sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    color: #A7A7A7;
  }

  .form-field .req {
    color: #A7A7A7;
  }

  .form-field input,
  .form-field textarea {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding: 14px 0;
    font-family: "Inter Tight", sans-serif;
    font-size: 16px;
    color: #FFFFFF;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: #5F5F5F;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    border-bottom-color: #417BFF;
  }

  .form-success {
    color: #61CE70;
    font-size: 14px;
    margin-top: 8px;
  }

  @media (max-width: 1024px) {
    .contact-cta-box {
      grid-template-columns: 1fr;
      padding: 40px 28px;
    }
  }

  @media (max-width: 640px) {
    .form-row-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
