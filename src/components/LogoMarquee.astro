---
const logos = [
  { src: "/assets/clients/erhaje.svg", alt: "SPK" },
  { src: "/assets/clients/ghanisa.svg", alt: "Porin Group" },
  { src: "/assets/clients/hadeha.svg", alt: "RBS" },
  { src: "/assets/clients/ihbs.svg", alt: "ADP" },
  { src: "/assets/clients/pravikara.svg", alt: "Hippogenz" },
  { src: "/assets/clients/slp.svg", alt: "SPK 2" },
  { src: "/assets/clients/client-logo-1.svg", alt: "AMI" },
  { src: "/assets/clients/veranda.svg", alt: "AMI" },
  { src: "/assets/clients/za.svg", alt: "AMI" },
  { src: "/assets/clients/client-logo-2.svg", alt: "AMI" },
];
---

<div class="nerimo-marquee-wrapper">
  <div class="nerimo-marquee-track">
    {logos.map((logo) => (
      <div class="logo-item">
        <img src={logo.src} alt={logo.alt} decoding="async" loading="lazy" />
      </div>
    ))}
    {logos.map((logo) => (
      <div class="logo-item" aria-hidden="true">
        <img src={logo.src} alt={logo.alt} decoding="async" loading="lazy" />
      </div>
    ))}
  </div>
</div>
