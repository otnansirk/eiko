---
const logos = [
  { src: "/assets/clients/erhaje.webp", alt: "SPK", width: 60, height: 60 },
  { src: "/assets/clients/ghanisa.webp", alt: "Porin Group", width: 64, height: 60 },
  { src: "/assets/clients/hadeha.webp", alt: "RBS", width: 60, height: 60 },
  { src: "/assets/clients/ihbs.webp", alt: "ADP", width: 60, height: 60 },
  { src: "/assets/clients/pravikara.webp", alt: "Hippogenz", width: 60, height: 60 },
  { src: "/assets/clients/slp.webp", alt: "SPK 2", width: 60, height: 60 },
  { src: "/assets/clients/client-logo-1.webp", alt: "AMI", width: 60, height: 60 },
  { src: "/assets/clients/veranda.webp", alt: "AMI", width: 60, height: 60 },
  { src: "/assets/clients/za.webp", alt: "AMI", width: 60, height: 60 },
  { src: "/assets/clients/client-logo-2.webp", alt: "AMI", width: 107, height: 60 },
];
---

<div class="nerimo-marquee-wrapper">
  <div class="nerimo-marquee-track">
    {logos.map((logo) => (
      <div class="logo-item">
        <img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} decoding="async" loading="lazy" fetchpriority="low" />
      </div>
    ))}
    {logos.map((logo) => (
      <div class="logo-item" aria-hidden="true">
        <img src={logo.src} alt="" width={logo.width} height={logo.height} decoding="async" loading="lazy" fetchpriority="low" />
      </div>
    ))}
  </div>
</div>
