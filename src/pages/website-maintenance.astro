const faqs = [
  {
    "question": "Mengapa perusahaan atau bisnis Anda wajib menggunakan jasa website maintenance profesional?",
    "answer": "<p>Website yang tidak dirawat secara berkala rentan terhadap celah keamanan siber, serangan malware, penurunan kecepatan loading, hingga broken link yang merusak peringkat SEO di Google. Layanan pemeliharaan dari Eiko Visual memastikan aset digital Anda selalu aman, stabil, dan berkinerja optimal tanpa mengganggu fokus operasional bisnis Anda.</p>"
  },
  {
    "question": "Apa saja ruang lingkup utama yang dikerjakan dalam layanan pemeliharaan website ini?",
    "answer": "<p>Ruang lingkup kami mencakup pembaruan rutin inti CMS dan plugin (core updates), monitoring keamanan 24/7 beserta pemasangan firewall (WAF), optimasi kecepatan muat halaman (speed optimization), manajemen backup dan pemulihan data berkala, serta pelaporan kesehatan situs secara transparan setiap bulan.</p>"
  },
  {
    "question": "Apakah layanan website maintenance ini cocok untuk semua jenis platform website?",
    "answer": "<p>Ya, Eiko Visual menangani berbagai platform populer seperti WordPress, WooCommerce, hingga custom website development. Setiap paket pemeliharaan disesuaikan secara spesifik dengan arsitektur teknologi dan skala kebutuhan bisnis Anda.</p>"
  },
  {
    "question": "Bagaimana cara Eiko Visual menangani situasi darurat jika website tiba-tiba down atau diretas?",
    "answer": "<p>Tim teknis kami langsung siaga melakukan mitigasi darurat melalui protokol pemulihan cepat (disaster recovery), pembersihan malware secara total, serta pemulihan data (restore) dari arsip backup aman terbaru yang kami simpan di cloud server terpisah.</p>"
  },
  {
    "question": "Seberapa sering pembaruan sistem (updates) dan pencadangan data (backup) dilakukan?",
    "answer": "<p>Frekuensi pembaruan dan pencadangan data disesuaikan dengan paket yang Anda pilih. Untuk paket Pro dan Enterprise, pembaruan komponen dan pencadangan data dilakukan secara rutin setiap minggu hingga setiap hari demi menjamin keamanan data transaksi dan konten perusahaan.</p>"
  },
  {
    "question": "Apakah saya akan mendapatkan laporan berkala terkait kondisi kesehatan website saya?",
    "answer": "<p>Tentu saja. Setiap bulan, klien akan menerima laporan analitik komprehensif yang mencakup status keamanan, riwayat pembaruan sistem, laporan performa kecepatan, serta catatan optimasi SEO teknis yang telah dikerjakan oleh tim kami.</p>"
  },
  {
    "question": "Bagaimana cara memulai kerja sama maintenance website dengan Eiko Visual?",
    "answer": "<p>Anda dapat mengklik tombol \"Konsultasikan Maintenance Website\" atau \"Konsultasi Sekarang\" di halaman ini. Tim kami akan melakukan audit awal (health check) pada website Anda, merekomendasikan paket yang paling efisien, dan langsung menjadwalkan proses pengamanan situs secepatnya.</p>"
  }
];

const relatedServices = [
  {
    "title": "Brand Development",
    "href": "/brand-development-details/"
