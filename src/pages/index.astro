    </div>
  </section>

  <!-- 4 Services Section -->
  <section class="home-services-section">
    <div class="container">
      <div class="section-header-row">
        <h2 class="has-gradient-text">
          Website dan Aplikasi Berkinerja Tinggi yang Menghasilkan <span
            >Konversi</span
          >
        </h2>
        <a href="/services/" class="eiko-btn">
          <span>Lihat Semua Layanan</span>
          <span class="btn-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
            >
              <path
                d="M3.33203 8H12.6654"
                stroke="#030208"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M8 3.33203L12.6667 7.9987L8 12.6654"
                stroke="#030208"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
        </a>
      </div>

      <div class="services-4-grid">
