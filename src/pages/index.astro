---
import BaseLayout from "../layouts/BaseLayout.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import FaqSection from "../components/FaqSection.astro";
import ContactSection from "../components/ContactSection.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((p) => p.data.featuredOnHome)
  .sort((a, b) => a.data.order - b.data.order);

const homeFaqs = [
  {
    question: "Kenapa konsistensi brand penting bagi perusahaan?",
    answer:
      "<p>Semakin besar perusahaan, semakin banyak tim yang membuat materi sendiri-sendiri. Tanpa standar yang sama, brand yang terbentuk tidak mudah diingat, dan tampilan yang beragam menunjukkan perusahaan yang tampak kurang terorganisir.</p>",
    open: true,
  },
  {
    question:
      "Bagaimana desain UI/UX membuat website dan aplikasi lebih mudah digunakan?",
    answer:
      "<p>Desain UI/UX memastikan pengguna langsung paham apa yang harus dilakukan. Pengalaman yang mulus menumbuhkan kepercayaan, dan membuat lebih banyak orang menyelesaikan tindakan penting seperti mendaftar, mengisi formulir, atau membeli.</p>",
  },
  {
    question:
      "Bisakah kami memesan satu layanan saja, misalnya website atau branding?",
    answer:
      "<p>Bisa. Tapi hasil terbaik muncul saat brand, website, dan pemasaran digital berjalan bersama dalam satu arah — karena itulah pelanggan Anda melihat brand yang sama, di mana pun mereka bertemu Anda.</p>",
  },
  {
    question: "Berapa biaya yang harus disiapkan?",
    answer:
      "<p>Biaya bergantung pada layanan dan ruang lingkup pekerjaan. Setelah konsultasi, kami kirim penawaran yang jelas dan rinci, tanpa biaya tersembunyi.</p>",
  },
  {
    question: "Berapa lama proses pengerjaannya?",
    answer:
      "<p>Durasi bergantung pada layanan dan kebutuhan proyek. Kami sampaikan estimasi waktu sejak awal, sebelum pekerjaan dimulai.</p>",
  },
  {
    question:
      "Kami sudah punya logo atau website lama. Apakah masih bisa dikerjakan?",
    answer:
      "<p>Bisa. Kami mulai dengan audit untuk melihat apa yang masih layak dipertahankan dan apa yang perlu diperbarui.</p>",
  },
  {
    question:
      "Apakah optimasi SEO dan digital marketing di Eiko Visual mengikuti panduan resmi dari Google?",
    answer: `<p>Ya, layanan analisis digital marketing kami disesuaikan dengan standar <a href="https://developers.google.com/search" target="_blank" rel="noopener">Google Search Central</a> untuk hasil pencarian optimal.</p>`,
  },
  {
    question: "Bagaimana alur kerja Eiko Visual dari awal sampai selesai?",
    answer: `<p>Kami mulai dari riset dan strategi, lalu masuk ke konsep kreatif, evaluasi bersama Anda, pengujian, sampai peluncuran — lihat detail lengkapnya di bagian "Cara Kami Bekerja" di atas.</p>`,
  },
];
---

<BaseLayout
  title="Jasa Branding dan Web Development - Eiko Visual"
  description="Eiko Visual adalah studio branding, web development, & digital marketing. Kami siap bantu kembangkan bisnis Anda. Konsultasi gratis!"
  ogImage="/assets/branding/og-image.png"
  preloadImage="/assets/heroes/home-hero.webp"
  preloadImageSrcset="/assets/heroes/home-hero-480w.webp 480w, /assets/heroes/home-hero.webp 680w"
>
  <!-- Hero Section -->
  <section class="hero-section starry-bg">
    <div class="container hero-grid">
      <div class="hero-left">
        <div class="hero-badge-top">
          <img
            class="badge-cursor-icon"
            src="/assets/icons/cursor-orange.webp"
            alt=""
            width="36"
            height="36"
            fetchpriority="low"
            decoding="async"
          />
          <span class="floating-badge-orange">Branding &amp; Digital</span>
        </div>

        <div class="hero-image-card">
          <img
            src="/assets/heroes/home-hero.webp"
            srcset="/assets/heroes/home-hero-480w.webp 480w, /assets/heroes/home-hero.webp 680w"
            sizes="(max-width: 768px) 260px, 680px"
            alt="Satu Sistem Branding dan Web Development Eiko Visual"
            width="680"
            height="383"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <div class="hero-marquee-area">
          <div class="hero-badge-trusted">
            <span class="floating-badge-yellow">Dipercaya oleh</span>
            <img
              class="badge-cursor-icon"
              src="/assets/icons/cursor-yellow.webp"
              alt=""
              width="36"
              height="36"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
          <LogoMarquee />
        </div>
      </div>

      <div class="hero-right">
        <div class="pill-badge">Studio Branding &amp; Digital</div>
        <h1 class="hero-title">Satu Brand, Satu Sistem, di Semua Touchpoint</h1>
        <p class="hero-desc">
          Eiko Visual menyediakan layanan <strong
            >branding dan web development</strong
          > yang terintegrasi untuk perusahaan menengah. Kami membangun identitas,
          website, dan pemasaran digital dalam satu sistem yang selaras dan terukur.
        </p>
        <a href="/contact/" class="eiko-btn">
          <span>Konsultasi Sekarang</span>
          <span class="btn-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
            >
              <path
                d="M3.33203 8H12.6654"
                stroke="#030208"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M8 3.33203L12.6667 7.9987L8 12.6654"
                stroke="#030208"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Stats & About Intro Section -->
  <section class="stats-section">
    <div class="container">
      <div class="count-boxes-grid">
        <div class="count-box">
          <div class="count-box-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 28 28"
              fill="none"
            >
              <path
                d="M5.13812 5.55745L12.7749 10.4947C13.1516 10.7382 13.4606 11.068 13.6743 11.4551C13.8881 11.8421 13.9999 12.2743 14 12.7134V26.6665C14 26.9079 13.9325 27.1447 13.8046 27.3518C13.6767 27.5589 13.4932 27.7284 13.2737 27.8423C13.0542 27.9562 12.8069 28.0101 12.5583 27.9984C12.3096 27.9867 12.069 27.9098 11.8619 27.7758L4.22512 22.8399C3.84816 22.5963 3.53908 22.2662 3.32535 21.8789C3.11162 21.4916 2.99986 21.0592 3 20.6199L3 6.66677C2.99996 6.42538 3.06751 6.18852 3.19542 5.98144C3.32334 5.77436 3.50683 5.60483 3.72632 5.49096C3.94581 5.37708 4.19307 5.32312 4.44171 5.33483C4.69035 5.34654 4.93105 5.42348 5.13812 5.55745ZM9.226 2.82416C9.44555 2.71025 9.69287 2.65628 9.94158 2.66802C10.1903 2.67976 10.431 2.75677 10.6381 2.89083L18.2749 7.82809C18.6516 8.07153 18.9606 8.40141 19.1743 8.78844C19.3881 9.17548 19.4999 9.6077 19.5 10.0467V23.9999C19.5 24.2412 19.4325 24.4781 19.3046 24.6852C19.1767 24.8923 18.9932 25.0618 18.7737 25.1757C18.5542 25.2896 18.3069 25.3435 18.0583 25.3318C17.8096 25.3201 17.569 25.2431 17.3619 25.1092L16.0625 24.2692V12.7134C16.0624 11.9451 15.8667 11.1887 15.4927 10.5114C15.1188 9.83411 14.5782 9.2568 13.9189 8.83074L8.5 5.32679V4.00014C8.4999 3.75876 8.56738 3.52188 8.69524 3.31477C8.8231 3.10766 9.00654 2.93809 9.226 2.82416ZM16.1381 0.224197L23.7749 5.16146C24.1516 5.4049 24.4606 5.73478 24.6743 6.12182C24.8881 6.50885 24.9999 6.94107 25 7.38009V21.3332C25 21.5746 24.9325 21.8115 24.8046 22.0186C24.6767 22.2256 24.4932 22.3952 24.2737 22.509C24.0542 22.6229 23.8069 22.6769 23.5583 22.6652C23.3096 22.6535 23.069 22.5765 22.8619 22.4425L21.5625 21.6026V10.0467C21.5624 9.27845 21.3667 8.5221 20.9927 7.84479C20.6188 7.16748 20.0782 6.59017 19.4189 6.16411L14 2.66016V1.33351C14 1.09213 14.0675 0.855258 14.1954 0.648178C14.3233 0.441099 14.5068 0.271577 14.7263 0.157699C14.9458 0.043821 15.1931 -0.0101409 15.4417 0.00157044C15.6904 0.0132817 15.931 0.0902268 16.1381 0.224197Z"
                fill="url(#home_stat_1)"></path>
              <defs
                ><linearGradient
                  id="home_stat_1"
                  x1="14"
                  y1="0"
                  x2="14"
                  y2="28"
                  gradientUnits="userSpaceOnUse"
                  ><stop stop-color="#00AA25"></stop><stop
                    offset="1"
                    stop-color="#00E431"></stop></linearGradient
                ></defs
              >
            </svg>
          </div>
          <div class="count-box-body">
            <div class="count-box-number">150</div>
            <div class="count-box-title">Proyek Selesai</div>
          </div>
        </div>

        <div class="count-box">
          <div class="count-box-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
