        <a href="/digital-marketing-details/" class="service-box">
          <div class="service-box-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 28 28"
              fill="none"
            >
              <circle cx="14" cy="14" r="10" stroke="#00E431" stroke-width="2.5"
              ></circle>
              <circle cx="14" cy="14" r="4" fill="#00AA25"></circle>
