              height="28"
              viewBox="0 0 28 28"
              fill="none"
            >
              <path
                d="M26.121 2.09239C22.7238 1.10911 15.3229 3.89982 11.3133 7.90786C9.36475 10.2102 6.89178 10.1922 5.83795 10.6515C2.86459 11.9602 1.99889 15.3749 1.75771 16.8438L7.10943 16.9297L9.33521 20.5079L10.5389 25.6534C12.6176 25.9952 16.0383 25.1295 17.3393 22.1561C18.6112 18.06 19.3836 17.4078 20.095 16.6923C24.1172 12.6903 26.8921 5.45458 26.121 2.09239Z"
                fill="#FF5100"></path>
            </svg>
          </div>
          <h3>Web Development</h3>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="home-projects-section">
    <div class="container">
      <h2 class="has-gradient-text section-title-mb">
        Brand yang Sudah <span>Kami Bantu</span>
      </h2>

      <div class="projects-stack">
        {
          featuredProjects.map((project) => (
            <div class="project-box">
              <div class="project-box-img">
                <img
                  src={project.data.cardImage}
                  alt={project.data.cardTitle}
