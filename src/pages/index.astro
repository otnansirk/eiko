<style>
  .hero-section {
    padding: 80px 0 96px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  .hero-left,
  .hero-right {
    min-width: 0;
    max-width: 100%;
  }

  .hero-left {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero-badge-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hero-image-card {
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  .hero-badge-trusted {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .hero-right {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero-title {
    font-size: clamp(36px, 4.5vw, 58px);
    line-height: 1.18;
  }

  .hero-desc {
    font-size: 17px;
    line-height: 1.7;
    color: #a7a7a7;
  }

  .hero-desc strong {
    color: #ffffff;
  }

  .stats-section {
    padding: 88px 0;
  }

  .stats-statement-wrap {
    margin-top: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 32px;
    max-width: 920px;
    margin-left: auto;
    margin-right: auto;
  }

  .stats-statement {
    font-size: clamp(22px, 2.8vw, 34px);
    line-height: 1.45;
  }

  .home-services-section,
  .home-projects-section,
  .workflow-section {
    padding: 88px 0;
  }

  .section-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }

  .section-title-mb {
    margin-bottom: 48px;
  }

  .services-4-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .projects-stack {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .project-summary {
    margin-top: 12px;
    color: #a7a7a7;
    line-height: 1.7;
  }

  .projects-cta-center {
    margin-top: 48px;
    display: flex;
    justify-content: center;
  }

  .workflow-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .workflow-card {
    display: flex;
    flex-direction: row;
    align-items: center;
