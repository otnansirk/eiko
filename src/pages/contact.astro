---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
---

<BaseLayout
  title="Contact - Eiko Visual - Your Branding Partner"
  description="Diskusikan Kebutuhan Brand & Marketing Bisnis Anda Sekarang. Kami membantu brand, website, dan pemasaran digital Anda tampil selaras."
>
  <!-- Hero Section -->
  <section class="page-hero starry-bg">
    <div class="container hero-grid">
      <div class="hero-left">
        <div class="floating-badge">
          <img
            class="badge-cursor-icon"
            src="/assets/icons/cursor-orange.webp"
            alt=""
            width="34"
            height="34"
          />
          <span class="floating-badge-orange">Kontak Kami</span>
        </div>
        <div class="hero-img-wrap">
          <img
            src="/assets/heroes/contact-hero.webp"
            srcset="/assets/heroes/contact-hero-480w.webp 480w, /assets/heroes/contact-hero.webp 680w"
            sizes="(max-width: 768px) 92vw, 680px"
            alt="Kontak Eiko Visual"
            width="680"
            height="380"
            fetchpriority="high"
          />
        </div>
        <div class="trusted-row">
          <span class="floating-badge-yellow">Dipercaya oleh</span>
          <img
            class="badge-cursor-icon"
            src="/assets/icons/cursor-yellow.webp"
            alt=""
            width="34"
            height="34"
          />
        </div>
        <LogoMarquee />
      </div>

      <div class="hero-right">
        <h1>Diskusikan Kebutuhan Brand &amp; Marketing Bisnis Anda Sekarang</h1>
        <p>
          Kami membantu brand, website, dan pemasaran digital Anda tampil selaras — sehingga lebih mudah dikenal, dipercaya, dan dipilih pelanggan.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Cards & Form Section -->
  <section class="contact-main-section">
    <div class="container contact-main-grid">
      <div class="contact-info-stack">
        <a href="mailto:project@eikovisual.com" class="count-box contact-info-card">
          <div class="count-box-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#00E431" stroke-width="2">
              <rect x="2" y="4" width="20" height="16" rx="3"/>
              <path d="M22 7l-10 7L2 7"/>
            </svg>
          </div>
          <div>
            <span class="contact-card-label"></span>
            <h2></h2>
          </div>
        </a>

        <a href="tel:+6285870339246" class="count-box contact-info-card">
          <div class="count-box-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#417BFF" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div>
            <span class="contact-card-label"></span>
            <h2></h2>
          </div>
        </a>

        <div class="count-box contact-info-card">
          <div class="count-box-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#FF5100" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <div>
            <span class="contact-card-label"></span>
            <h2></h2>
          </div>
        </div>
      </div>

      <div class="contact-form-panel">
        <div class="contact-form-top">
          <div class="get-in-touch-badge">
            <img src="/assets/icons/sparkle-plus.webp" alt="" width="36" height="36" />
            <span>Get in touch</span>
          </div>
          <div class="floating-badge">
            <span class="floating-badge-orange">Design Studio</span>
            <img
              class="badge-cursor-icon"
              src="/assets/icons/cursor-contact.webp"
              alt=""
              width="34"
              height="34"
            />
          </div>
        </div>

        <h2 class="gradient-para form-panel-heading">
          Saatnya Brand Anda Tampil Konsisten di Setiap Titik Pertemuan dengan Pelanggan
        </h2>

        <form class="eiko-contact-form" data-mailto-form>
          <div class="form-row-2">
            <div class="form-field">
              <label for="c-name">Name <span>*</span></label>
              <input type="text" id="c-name" name="name" placeholder="Alex Johnson" />
            </div>
            <div class="form-field">
              <label for="c-phone">Phone <span>*</span></label>
              <input type="tel" id="c-phone" name="phone" placeholder="Phone Number" />
            </div>
          </div>

          <div class="form-field">
            <label for="c-email">Email</label>
            <input type="email" id="c-email" name="email" placeholder="Enter Your Email" />
          </div>

          <div class="form-field">
            <label for="c-message">Messages</label>
            <textarea id="c-message" name="message" rows="5" placeholder="Tell Us More About Projects..."></textarea>
          </div>

          <a href="mailto:project@eikovisual.com" class="eiko-btn" data-mailto-link>
            <span>Contact Us</span>
            <span class="btn-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3.33203 8H12.6654" stroke="#030208" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M8 3.33203L12.6667 7.9987L8 12.6654" stroke="#030208" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('[data-mailto-form]').forEach((form) => {
      const link = form.querySelector('[data-mailto-link]');
      if (!link) return;
      const updateMailto = () => {
        const name = (form.querySelector('[name="name"]')?.value || '').trim();
        const phone = (form.querySelector('[name="phone"]')?.value || '').trim();
        const email = (form.querySelector('[name="email"]')?.value || '').trim();
        const message = (form.querySelector('[name="message"]')?.value || '').trim();
        if (!name && !phone && !email && !message) {
          link.setAttribute('href', 'mailto:project@eikovisual.com');
          return;
        }
        const subject = name ? `Inquiry from ${name} - Eiko Visual` : 'Project Inquiry - Eiko Visual';
        const bodyLines = [];
        if (name) bodyLines.push(`Name: ${name}`);
        if (phone) bodyLines.push(`Phone: ${phone}`);
        if (email) bodyLines.push(`Email: ${email}`);
        if (message) bodyLines.push(`\nMessage:\n${message}`);
        link.setAttribute(
          'href',
          `mailto:project@eikovisual.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join('\n'))}`
        );
      };
      form.addEventListener('input', updateMailto);
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        updateMailto();
        window.location.href = link.getAttribute('href') || 'mailto:project@eikovisual.com';
      });
    });
  </script>
</BaseLayout>

<style>
  .page-hero {
    padding: 80px 0 96px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  .hero-left,
  .hero-right {
    min-width: 0;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero-img-wrap {
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .trusted-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .contact-main-section {
    padding: 88px 0 110px;
  }

  .contact-main-grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 40px;
    align-items: start;
  }

  .contact-info-stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-info-card .contact-card-label {
    display: block;
    color: #A7A7A7;
    font-size: 14px;
    font-weight: 400;
    margin-bottom: 6px;
  }

  .contact-info-card h2 {
    font-size: 22px;
    word-break: break-word;
  }

  .contact-form-panel {
    background-color: #121117;
    border: 1px solid rgba(234, 234, 234, 0.14);
    border-radius: 40px;
    padding: 56px;
  }

  .contact-form-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .get-in-touch-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #FFFFFF;
    font-family: "Inter Tight", sans-serif;
    font-weight: 500;
  }

  .form-panel-heading {
    font-size: clamp(26px, 3vw, 38px);
    margin-bottom: 36px;
  }

  .eiko-contact-form {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .form-field label {
    font-family: "Inter Tight", sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #A7A7A7;
  }

  .form-field input,
  .form-field textarea {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding: 14px 0;
    font-family: "Inter Tight", sans-serif;
    font-size: 16px;
    color: #FFFFFF;
    outline: none;
  }

  .form-success {
    color: #61CE70;
  }

  @media (max-width: 1024px) {
    .hero-grid,
    .contact-main-grid {
      grid-template-columns: 1fr;
    }
    .contact-form-panel {
      padding: 36px 24px;
    }
  }

  @media (max-width: 640px) {
    .form-row-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
