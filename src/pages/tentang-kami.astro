---
import BaseLayout from "../layouts/BaseLayout.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import FaqSection from "../components/FaqSection.astro";
import ContactSection from "../components/ContactSection.astro";

const aboutFaqs = [
  {
    question: "Apa yang membedakan Eiko Visual dari studio desain lain?",
    answer:
      "<p>Kami tidak hanya mengerjakan desain, tapi membangun brand Anda secara menyeluruh — mulai dari identitas, website, sampai pemasaran digital — dalam satu sistem yang konsisten dan bisa diukur hasilnya.</p>",
  },
  {
    question: "Apa saja layanan yang ditangani Eiko Visual?",
    answer:
      "<p>Kami fokus pada empat layanan utama: Brand Development, Digital Marketing, Website (development, maintenance, dan management), serta Aplikasi Mobile/Web — semuanya dikerjakan dalam satu arah yang sama.</p>",
    open: true,
  },
  {
    question: "Bisakah kami memesan satu layanan saja sesuai kebutuhan?",
    answer:
      "<p>Bisa. Tapi hasil terbaik muncul saat brand, website, dan pemasaran digital berjalan bersama dalam satu arah yang sama.</p>",
  },
  {
    question: "Berapa lama rata-rata durasi pengerjaan proyek?",
    answer:
      "<p>Branding and standard web projects typically take 2–4 weeks, while complex web applications and custom illustration systems range from 4–8 weeks depending on scope.</p>",
  },
  {
    question: "Bagaimana cara memulai proyek dengan Eiko Visual?",
    answer:
      "<p>Simply reach out through our contact form or email us at <!--email_off-->project@eikovisual.com<!--/email_off-->. We will schedule an initial discovery call to discuss your goals and project requirements.</p>",
  },
];

const teamMembers = [
  {
    name: "Riyan Ilham",
    role: "Brand Strategist",
    image: "/assets/team/riyan-ilham.webp",
  },
  {
    name: "Febi Grasinaz",
    role: "Founder & Digital Marketing",
    image: "/assets/team/febi-grasinaz.webp",
  },
  {
    name: "Krisnanto",
    role: "Full-Stack Developer",
    image: "/assets/team/krisnanto.webp",
  },
  {
    name: "Taufik Saputra",
    role: "Graphic Designer",
    image: "/assets/team/taufik_saputra.webp",
  },
];
---

<BaseLayout
  title="Tentang Kami - Eiko Visual - Your Branding Partner"
  description="Kami adalah Partner Anda dalam Menjaga Brand Tetap Konsisten. Kami mendampingi Anda dari briefing awal sampai brand Anda siap dipakai di semua media."
>
  <!-- Hero Section -->
  <section class="page-hero starry-bg">
    <div class="container hero-grid">
      <div class="hero-left">
        <div class="hero-img-wrap">
          <img
            src="/assets/heroes/about-hero.webp"
            srcset="/assets/heroes/about-hero-480w.webp 480w, /assets/heroes/about-hero.webp 680w"
            sizes="(max-width: 768px) 260px, 680px"
            alt="Tentang Eiko Visual"
            width="680"
            height="380"
            fetchpriority="high"
          />
        </div>
        <div class="trusted-row">
          <span class="floating-badge-yellow">Dipercaya oleh</span>
        </div>
        <LogoMarquee />
      </div>

      <div class="hero-right">
        <div class="floating-badge">
          <img
            class="badge-cursor-icon"
            src="/assets/icons/cursor-orange.webp"
            alt=""
            width="34"
            height="34"
          />
          <span class="floating-badge-orange">Tentang Kami</span>
        </div>
        <h1 class="has-gradient-text">
          Kami adalah Partner Anda dalam Menjaga Brand Tetap Konsisten
        </h1>
        <p>
          Kami akan mendampingi Anda dari briefing awal sampai brand Anda siap
          dipakai di semua media, supaya Anda tidak menjalankannya sendirian.
        </p>
        <a
          href="/assets/documents/company-profile-eiko-visual.pdf"
          class="eiko-btn"
          target="_blank"
          rel="noopener"
        >
          <span>Download Company Proffile</span>
          <span class="btn-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
            >
              <path
                d="M3.33203 8H12.6654"
                stroke="#030208"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M8 3.33203L12.6667 7.9987L8 12.6654"
                stroke="#030208"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Misi & Visi Section -->
  <section class="mission-section">
    <div class="container">
      <div class="mission-top">
        <div class="mission-badge">
          <img
            src="/assets/icons/sparkle-plus.webp"
            alt=""
            width="36"
            height="36"
          />
          <span>Misi &amp; Visi Kami</span>
        </div>
        <h2 class="gradient-para mission-statement">
          Kami punya tujuan yang jelas: setiap proyek dirancang berdasarkan
          target bisnis Anda, lalu diterapkan secara konsisten di semua media
          dari branding, website, sampai pemasaran digitalnya supaya lebih mudah
          menghasilkan pelanggan baru.
        </h2>
      </div>
    </div>
  </section>

  <!-- Komitmen Kami Section -->
  <section class="commitment-section starry-bg">
    <div class="container">
      <h2 class="has-gradient-text section-heading-center">
        Komitmen Kami <span>untuk Brand Anda</span>
      </h2>

      <div class="count-boxes-grid">
        <div class="count-box">
          <div class="count-box-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 28 28"
              fill="none"
            >
              <path
                d="M5.13812 5.55745L12.7749 10.4947C13.1516 10.7382 13.4606 11.068 13.6743 11.4551C13.8881 11.8421 13.9999 12.2743 14 12.7134V26.6665C14 26.9079 13.9325 27.1447 13.8046 27.3518C13.6767 27.5589 13.4932 27.7284 13.2737 27.8423C13.0542 27.9562 12.8069 28.0101 12.5583 27.9984C12.3096 27.9867 12.069 27.9098 11.8619 27.7758L4.22512 22.8399C3.84816 22.5963 3.53908 22.2662 3.32535 21.8789C3.11162 21.4916 2.99986 21.0592 3 20.6199L3 6.66677C2.99996 6.42538 3.06751 6.18852 3.19542 5.98144C3.32334 5.77436 3.50683 5.60483 3.72632 5.49096C3.94581 5.37708 4.19307 5.32312 4.44171 5.33483C4.69035 5.34654 4.93105 5.42348 5.13812 5.55745ZM9.226 2.82416C9.44555 2.71025 9.69287 2.65628 9.94158 2.66802C10.1903 2.67976 10.431 2.75677 10.6381 2.89083L18.2749 7.82809C18.6516 8.07153 18.9606 8.40141 19.1743 8.78844C19.3881 9.17548 19.4999 9.6077 19.5 10.0467V23.9999C19.5 24.2412 19.4325 24.4781 19.3046 24.6852C19.1767 24.8923 18.9932 25.0618 18.7737 25.1757C18.5542 25.2896 18.3069 25.3435 18.0583 25.3318C17.8096 25.3201 17.569 25.2431 17.3619 25.1092L16.0625 24.2692V12.7134C16.0624 11.9451 15.8667 11.1887 15.4927 10.5114C15.1188 9.83411 14.5782 9.2568 13.9189 8.83074L8.5 5.32679V4.00014C8.4999 3.75876 8.56738 3.52188 8.69524 3.31477C8.8231 3.10766 9.00654 2.93809 9.226 2.82416ZM16.1381 0.224197L23.7749 5.16146C24.1516 5.4049 24.4606 5.73478 24.6743 6.12182C24.8881 6.50885 24.9999 6.94107 25 7.38009V21.3332C25 21.5746 24.9325 21.8115 24.8046 22.0186C24.6767 22.2256 24.4932 22.3952 24.2737 22.509C24.0542 22.6229 23.8069 22.6769 23.5583 22.6652C23.3096 22.6535 23.069 22.5765 22.8619 22.4425L21.5625 21.6026V10.0467C21.5624 9.27845 21.3667 8.5221 20.9927 7.84479C20.6188 7.16748 20.0782 6.59017 19.4189 6.16411L14 2.66016V1.33351C14 1.09213 14.0675 0.855258 14.1954 0.648178C14.3233 0.441099 14.5068 0.271577 14.7263 0.157699C14.9458 0.043821 15.1931 -0.0101409 15.4417 0.00157044C15.6904 0.0132817 15.931 0.0902268 16.1381 0.224197Z"
                fill="url(#about_stat_1)"></path>
              <defs
                ><linearGradient
                  id="about_stat_1"
                  x1="14"
                  y1="0"
                  x2="14"
                  y2="28"
                  gradientUnits="userSpaceOnUse"
                  ><stop stop-color="#00AA25"></stop><stop
                    offset="1"
                    stop-color="#00E431"></stop></linearGradient
                ></defs
              >
            </svg>
          </div>
          <div class="count-box-body">
            <div class="count-box-number">150</div>
            <div class="count-box-title">Proyek diselesaikan</div>
          </div>
        </div>

        <div class="count-box">
          <div class="count-box-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 28 28"
              fill="none"
            >
              <path
                d="M11.0832 18.6667C6.57284 18.6667 2.9165 15.0104 2.9165 10.5C2.9165 5.98971 6.57284 2.33337 11.0832 2.33337C15.5935 2.33337 19.2498 5.98971 19.2498 10.5"
                fill="url(#about_stat_2a)"></path>
              <path
                d="M25.6665 10.5H10.4998V25.6667H25.6665V10.5Z"
                fill="url(#about_stat_2b)"></path>
              <defs>
                <linearGradient
                  id="about_stat_2a"
                  x1="14.2915"
                  y1="2.33337"
                  x2="14.2915"
                  y2="25.6667"
                  gradientUnits="userSpaceOnUse"
                  ><stop stop-color="#FFD51A"></stop><stop
                    offset="1"
                    stop-color="#FFA01A"></stop></linearGradient
                >
                <linearGradient
                  id="about_stat_2b"
                  x1="14.2915"
                  y1="2.33337"
                  x2="14.2915"
                  y2="25.6667"
                  gradientUnits="userSpaceOnUse"
                  ><stop stop-color="#FFD51A"></stop><stop
                    offset="1"
                    stop-color="#FFA01A"></stop></linearGradient
                >
              </defs>
            </svg>
          </div>
          <div class="count-box-body">
            <div class="count-box-number">4</div>
            <div class="count-box-title">4 Layanan Terpadu</div>
          </div>
        </div>

        <div class="count-box">
          <div class="count-box-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 28 28"
              fill="none"
            >
              <path
                d="M4.93341 5.26316L5.83342 8.98785L4.93341 12.6964L8.28341 14.7045L10.3334 17.9595L14.1667 17.085L18.0001 17.9595L20.0501 14.7045L23.4001 12.6964L22.5001 8.98785L23.4001 5.26316L20.0667 3.25506L18.0001 0L14.1667 0.890688L10.3501 0.0161943L8.26675 3.25506L4.93341 5.26316ZM14.1834 15.5304C12.4153 15.5304 10.7196 14.8479 9.46937 13.6331C8.21913 12.4183 7.51675 10.7706 7.51675 9.05263C7.51675 7.33463 8.21913 5.68699 9.46937 4.47218C10.7196 3.25737 12.4153 2.5749 14.1834 2.5749C17.8501 2.5749 20.8334 5.47368 20.8334 9.03644C20.8334 12.6316 17.8501 15.5304 14.1834 15.5304ZM14.1501 13.9109C11.3834 13.9109 9.16675 11.7409 9.16675 9.05263C9.16675 6.38057 11.3834 4.19433 14.1501 4.19433C16.9167 4.19433 19.1667 6.38057 19.1667 9.05263C19.1667 11.7409 16.9167 13.9109 14.1501 13.9109ZM20.5501 15.6923L18.4167 19.3198L14.9501 18.5587L19.1667 28L21.5001 24.4372H25.6667L20.5501 15.6923ZM7.71675 15.8057L9.80008 19.4494L13.3501 18.6235L9.16675 28L6.83342 24.4372H2.66675L7.71675 15.8057Z"
                fill="url(#about_stat_3)"></path>
              <defs
                ><linearGradient
                  id="about_stat_3"
                  x1="14.1667"
                  y1="0"
                  x2="14.1667"
                  y2="28"
                  gradientUnits="userSpaceOnUse"
                  ><stop stop-color="#417BFF"></stop><stop
                    offset="1"
                    stop-color="#1A5FFF"></stop></linearGradient
                ></defs
              >
            </svg>
          </div>
          <div class="count-box-body">
            <div class="count-box-number">96%</div>
            <div class="count-box-title">
              Klien puas dengan<br />hasil akhir
            </div>
          </div>
        </div>

        <div class="count-box">
          <div class="count-box-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
            >
              <g clip-path="url(#about_stat_4_clip)">
                <path
                  d="M0.581836 6.93857L11.5009 11.8919C11.8196 12.0367 12.1801 12.0367 12.4989 11.8919L23.4179 6.93857C24.1937 6.58654 24.1937 5.4142 23.4179 5.06217L12.4993 0.10842C12.3427 0.0368162 12.1725 -0.000244141 12.0004 -0.000244141C11.8282 -0.000244141 11.658 0.0368162 11.5014 0.10842L0.581836 5.0617C-0.193945 5.41373 -0.193945 6.58654 0.581836 6.93857ZM23.4184 11.0767L20.6954 9.84248L13.1186 13.277C12.7642 13.4378 12.3878 13.5194 12.0001 13.5194C11.6125 13.5194 11.2365 13.4378 10.8817 13.277L3.30527 9.84248L0.581836 11.0767C-0.193945 11.4283 -0.193945 12.6001 0.581836 12.9517L11.5009 17.9012C11.8196 18.0456 12.1801 18.0456 12.4989 17.9012L23.4184 12.9517C24.1942 12.6001 24.1942 11.4283 23.4184 11.0767ZM23.4184 17.0673L20.7057 15.8378L13.1186 19.277C12.7642 19.4378 12.3878 19.5194 12.0001 19.5194C11.6125 19.5194 11.2365 19.4378 10.8817 19.277L3.29496 15.8378L0.581836 17.0673C-0.193945 17.4189 -0.193945 18.5908 0.581836 18.9423L11.5009 23.8919C11.8196 24.0362 12.1801 24.0362 12.4989 23.8919L23.4184 18.9423C24.1942 18.5908 24.1942 17.4189 23.4184 17.0673Z"
                  fill="url(#about_stat_4)"></path>
              </g>
              <defs>
                <linearGradient
                  id="about_stat_4"
                  x1="12.0001"
                  y1="-0.000244141"
                  x2="12.0001"
                  y2="24.0001"
                  gradientUnits="userSpaceOnUse"
                  ><stop stop-color="#FF8B55"></stop><stop
                    offset="1"
                    stop-color="#FF5100"></stop></linearGradient
                >
                <clipPath id="about_stat_4_clip"
                  ><rect width="24" height="24" fill="white"></rect></clipPath
                >
              </defs>
            </svg>
          </div>
          <div class="count-box-body">
            <div class="count-box-number">3+</div>
            <div class="count-box-title">Tahun pengalaman</div>
          </div>
        </div>
      </div>

      <div class="commitment-bottom">
        <h3 class="gradient-para">
          Eiko Visual membantu bisnis berkembang lewat brand yang utuh dan
          konsisten — mulai dari identitas visual, website, pemasaran digital,
          sampai aplikasi, semuanya dalam satu standar yang sama.
        </h3>
        <a href="/services/" class="eiko-btn">
          <span>Lihat Layanan Kami</span>
          <span class="btn-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
            >
              <path
                d="M3.33203 8H12.6654"
                stroke="#030208"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M8 3.33203L12.6667 7.9987L8 12.6654"
                stroke="#030208"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Tim Kami Section -->
  <section class="team-section">
    <div class="container">
      <h2 class="has-gradient-text section-heading-center">
        Tim Kami Menjaga <span>Konsistensi Brand Anda</span>
      </h2>

      <div class="team-grid">
        {
          teamMembers.map((member) => (
            <div
              class="team-card team-box"
              style={`background-image: url('${member.image}');`}
            >
              <h3>{member.name}</h3>
              <p class="team-role">{member.role}</p>
            </div>
          ))
        }
      </div>

      <div class="team-cta">
        <h3>
          Punya tantangan branding di perusahaan Anda?<br />Mari kita bahas
          bersama.
        </h3>
        <a href="/contact/" class="eiko-btn">
          <span>Jadwalkan Diskusi</span>
          <span class="btn-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
            >
              <path
                d="M3.33203 8H12.6654"
                stroke="#030208"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M8 3.33203L12.6667 7.9987L8 12.6654"
                stroke="#030208"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FaqSection
    leftHeading="Masih Ada<br> Pertanyaan Lain?"
    faqs={aboutFaqs}
    defaultOpenIndex={1}
  />

  <!-- Contact Section -->
  <ContactSection
    badgeText="Studio"
    heading="Saatnya Brand Anda Tampil Konsisten di Setiap Titik Pertemuan dengan Pelanggan"
    description="Ceritakan brand Anda, kami bantu rancang dari identitas sampai strategi pemasarannya."
  />
</BaseLayout>

<style>
  .page-hero {
    padding: 80px 0 96px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  .hero-left,
  .hero-right {
    min-width: 0;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero-img-wrap {
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .trusted-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .mission-section,
  .commitment-section,
  .team-section {
    padding: 88px 0;
  }

  .mission-top {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 40px;
    align-items: start;
    margin-bottom: 56px;
  }

  .mission-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #ffffff;
    font-weight: 500;
  }

  .mission-statement {
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.45;
  }

  .mission-bottom {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 32px;
  }

  .mission-stats {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .about-showcase-card {
    background-color: #121117;
    border: 1px solid rgba(234, 234, 234, 0.15);
    border-radius: 40px;
    padding: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .showcase-divider {
    font-size: 48px;
    color: #417bff;
    font-weight: 600;
  }

  .section-heading-center {
    text-align: center;
    margin-bottom: 48px;
  }

  .commitment-bottom,
  .team-cta {
    margin-top: 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }

  .team-card {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 480px;
    gap: 8px;
    border-radius: 20px;
    padding: 32px;
    overflow: hidden;
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
    text-align: left;
  }

  .team-card::after {
    content: "";
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0) 39.08%,
      rgba(18, 17, 23, 0.7) 70.19%,
      #121117 100%
    );
    z-index: -1;
    border-radius: inherit;
  }

  .team-card h3 {
    font-family: "Space Grotesk", var(--font-sans);
    font-size: 20px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: 0.02em;
    color: #ffffff;
    margin: 0;
  }

  .team-card .team-role {
    font-family: "Space Grotesk", var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 24px;
    color: #a7a7a7;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .hero-grid,
    .mission-top,
    .mission-bottom {
      grid-template-columns: 1fr;
    }
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .team-card {
      min-height: 380px;
    }
  }

  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
