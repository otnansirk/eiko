---

<ServiceDetailLayout
  seoTitle="Jasa Digital Marketing untuk Perusahaan | Eiko Visual"
  metaDescription="Jasa digital marketing terarah dan terukur: strategi konten, media sosial, dan iklan untuk menjangkau pelanggan yang tepat. Konsultasi sekarang."
  serviceTitle="Digital Marketing"
  heroDescription="Kehadiran produk terbaik tidak akan maksimal tanpa strategi akuisisi yang tepat sasaran. Eiko Visual membantu merancang dan menjalankan kampanye pemasaran digital yang terukur untuk mendatangkan konversi bisnis secara konsisten."
  valuePropPrefix="Mengapa Digital Marketing Menjadi Fondasi Utama"
  valuePropHighlight="Keberhasilan Bisnis Jangka Panjang?"
  valuePropSubheading="Strategi pemasaran digital yang matang memastikan bisnis Anda menjangkau audiens yang tepat, memaksimalkan anggaran iklan secara efektif, dan mendorong pertumbuhan omzet secara berkelanjutan."
  features={features}
  categoriesHeadingHighlight="Digital Marketing"
  categories={categories}
  stepsHeadingHighlight="Digital Marketing."
  steps={steps}
  faqs={faqs}
  relatedServices={relatedServices}
  ctaHeading="Saatnya Pemasaran Digital Anda Bekerja Satu Arah dengan Brand Anda"
  ctaDescription="Ceritakan kondisi pemasaran digital Anda saat ini. Tim kami akan mempelajarinya dan membahas langkah yang tepat"
/>
